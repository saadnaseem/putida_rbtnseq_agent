# The raw dataset in data/ IS tracked — this repo is self-contained.
# Only the derived parquet cache is ignored: scripts/build_cache.py rebuilds it
# from data/ byte-identically, and committing regenerated binaries would bloat
# history on every rebuild.
/data/cache/

# Papers are not redistributed here; the DOIs are in README.md
*.pdf

# Generated figures
*.png
*.svg

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# OS / editor
.DS_Store
.vscode/
.idea/
